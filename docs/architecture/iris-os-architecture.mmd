  end

  subgraph Providers["External providers"]
    Supabase["Supabase Auth"]
    Adapters["Google, Meta, Canva, finance, SMTP adapters"]
    Atlas["Gemini, OpenAI, Anthropic through Atlas orchestration"]
  end

