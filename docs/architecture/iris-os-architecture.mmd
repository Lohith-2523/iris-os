graph TB
  subgraph Browser["Browser"]
    RSC["Populated RSC and HTML"]
    Interactive["Interactive Client Components"]
    Cache["workspaceFetch refresh cache"]
    Crypto["Messaging OpenPGP + IndexedDB keys"]
  end

  subgraph Request["Next.js 16 request path"]
    Proxy["Minimal proxy: Supabase refresh, route gate, headers"]
